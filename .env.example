# ==========================================================
# このファイルをコピーして「.env」という名前で保存し、値を設定してください。
# .env はGitに絶対にコミットしないでください（.gitignoreに追加済み）。
# ==========================================================

# --- Google Sheets 連携 ---
# スプレッドシートのID（URLの /d/ と /edit の間の文字列）
GOOGLE_SPREADSHEET_ID=1HL7zWdpXmoY0H-3uHVLrYBwuUTckA_71moylVukp6Ig

# 予約管理表のシート名（タブ名）
GOOGLE_SHEET_NAME=シート1

# サービスアカウントの認証情報（JSON）を1行の文字列にして設定
# 例: GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN...","client_email":"...@....iam.gserviceaccount.com", ... }
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- 外部リンク ---
LINE_URL=https://lin.ee/vHyEpWl
OFFICIAL_SITE_URL=https://lifemanipulative0517.wixsite.com/my-site

# --- サーバー設定 ---
PORT=3000

# キャッシュの有効時間（分）
CACHE_MINUTES=5

# 管理者用の手動更新エンドポイントを叩くための簡易トークン（他人に推測されない文字列にしてください）
ADMIN_REFRESH_TOKEN=change_this_to_a_random_string
